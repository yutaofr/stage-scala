          "datasource": {"type": "prometheus", "uid": "prometheus-clearing"},
          "editorMode": "code",
          "expr": "(sum(rate(clearing_transactions_processed_total{status=\"failure\"}[$__rate_interval])) / clamp_min(sum(rate(clearing_transactions_processed_total[$__rate_interval])), 1e-9)) or vector(0)",
